# Salin ke .env untuk development. JANGAN commit .env atau isi secrets/.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Role DB terpisah (PRD §12.5): pfm_app untuk API, pfm_migrator untuk migrasi.
DATABASE_URL=postgres://pfm_app:pfm_app_dev@localhost:5432/pfm?sslmode=disable
MIGRATION_DATABASE_URL=postgres://pfm_migrator:pfm_migrator_dev@localhost:5432/pfm?sslmode=disable
DB_MAX_CONNS=20

# make keys
JWT_PRIVATE_KEY_FILE=./secrets/jwt_ed25519.pem
JWT_ISSUER=pfm-backend
JWT_AUDIENCE=pfm-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
ACTIVATION_KEY_TTL=24h

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Isi dengan IP/CIDR load balancer di production agar IP klien tidak bisa dipalsukan.
TRUSTED_PROXIES=
REQUEST_TIMEOUT=10s
RATE_LIMIT_PER_MINUTE=300

# Image -> disk lokal
STORAGE_IMAGE_ROOT=./var/images

# Dokumen -> S3 (dev: MinIO dari deploy/docker-compose.yml)
S3_BUCKET=pfm-documents
S3_REGION=ap-southeast-3
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true
S3_KMS_KEY_ID=
S3_PRESIGN_TTL=5m
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-dev

# Hanya untuk `make seed-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

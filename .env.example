# Salin ke .env untuk development. JANGAN commit .env atau isi secrets/.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug

# Empat database terpisah, masing-masing dengan user sendiri (PRD §7.1, §12.5;
# deploy/postgres/roles.sql). Satu DSN bocor hanya membuka satu database.
DATABASE_URL_CORE=postgres://pfm_core_app:pfm_core_app_dev@localhost:5432/pfm_core?sslmode=disable
DATABASE_URL_SECURITY=postgres://pfm_security_app:pfm_security_app_dev@localhost:5432/pfm_security?sslmode=disable
# API hanya membaca log; worker memakai pfm_log_writer (lihat bagian worker).
DATABASE_URL_LOG=postgres://pfm_log_reader:pfm_log_reader_dev@localhost:5432/pfm_log?sslmode=disable
DATABASE_URL_DOCUMENT=postgres://pfm_document_app:pfm_document_app_dev@localhost:5432/pfm_document?sslmode=disable

MIGRATION_DATABASE_URL_CORE=postgres://pfm_migrator:pfm_migrator_dev@localhost:5432/pfm_core?sslmode=disable
MIGRATION_DATABASE_URL_SECURITY=postgres://pfm_migrator:pfm_migrator_dev@localhost:5432/pfm_security?sslmode=disable
MIGRATION_DATABASE_URL_LOG=postgres://pfm_migrator:pfm_migrator_dev@localhost:5432/pfm_log?sslmode=disable
MIGRATION_DATABASE_URL_DOCUMENT=postgres://pfm_migrator:pfm_migrator_dev@localhost:5432/pfm_document?sslmode=disable
DB_MAX_CONNS=20

# Worker (cmd/worker; ikut berjalan di `make dev`) memakai user DB sendiri. Kosongkan untuk
# memakai DATABASE_URL_* di atas (mis. bila semuanya memakai superuser lokal).
WORKER_DATABASE_URL_CORE=postgres://pfm_worker:pfm_worker_dev@localhost:5432/pfm_core?sslmode=disable
WORKER_DATABASE_URL_SECURITY=postgres://pfm_worker:pfm_worker_dev@localhost:5432/pfm_security?sslmode=disable
WORKER_DATABASE_URL_LOG=postgres://pfm_log_writer:pfm_log_writer_dev@localhost:5432/pfm_log?sslmode=disable
WORKER_DATABASE_URL_DOCUMENT=postgres://pfm_worker:pfm_worker_dev@localhost:5432/pfm_document?sslmode=disable

# make keys
JWT_PRIVATE_KEY_FILE=./secrets/jwt_ed25519.pem
JWT_ISSUER=pfm-backend
JWT_AUDIENCE=pfm-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
ACTIVATION_KEY_TTL=24h

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Isi dengan IP/CIDR load balancer di production agar IP klien tidak bisa dipalsukan.
TRUSTED_PROXIES=
REQUEST_TIMEOUT=10s
RATE_LIMIT_PER_MINUTE=300

# Image -> disk lokal
STORAGE_IMAGE_ROOT=./var/images

# Dokumen -> S3 (dev: MinIO dari deploy/docker-compose.yml)
S3_BUCKET=pfm-documents
S3_REGION=ap-southeast-3
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true
S3_KMS_KEY_ID=
S3_PRESIGN_TTL=5m
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-dev

# Hanya untuk `make seed-admin`
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Email (link aktivasi & reset password). API hanya mengantrekan email (mail_outbox);
# worker yang mengirim lewat SMTP. Tanpa SMTP_HOST email tetap di antrean.
# Development dengan Mailpit dari deploy/docker-compose.yml (kotak masuk: http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
# Mailtrap (Email Testing -> Inbox -> SMTP Settings):
#   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  SMTP_TLS=starttls
#   SMTP_USERNAME=<username inbox>      SMTP_PASSWORD=<password inbox>
SMTP_FROM=no-reply@pfm.local
SMTP_FROM_NAME=PFM
SMTP_TIMEOUT=15s
# Halaman frontend penerima tautan: <FRONTEND_BASE_URL>/activate?key=... dan /reset-password?key=...
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TTL=1h
